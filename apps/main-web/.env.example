# main-web has no runtime env vars beyond the contact API URL.

# Base URL of the dikshant API. Used by the /connect contact form to save
# submissions to the database and by the homepage featured/latest posts section.
# Set to https://api.dikshantyadav.in in production.
VITE_API_URL=https://api.dikshantyadav.in

# Base URL of the posts website. Used by the homepage "Featured Posts" section
# to link individual articles and the "Go to Posts" CTA.
# Set to https://posts.dikshantyadav.in in production.
VITE_POST_URL=https://post.dikshantyadav.in
